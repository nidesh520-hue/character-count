#include<stdio.h>
#include<string.h>

int main(){
    char d[20][20], f[20][25];
    int n,l,c;

    printf("Enter number of frames: ");
    scanf("%d",&n); getchar();

    for(int i=0;i<n;i++){
        printf("Enter Frame %d: ",i+1);
        fgets(d[i],20,stdin);
        d[i][strlen(d[i])-1]='\0';
    }

    printf("\nAT THE SENDER\nFrames after adding count:\n");
    for(int i=0;i<n;i++){
        l=strlen(d[i]);
        f[i][0]=l+'0'; f[i][1]='\0';
        strcat(f[i],d[i]);
        printf("Frame %d: %s\n",i+1,f[i]);
    }

    printf("Transmitted Data: ");
    for(int i=0;i<n;i++) printf("%s",f[i]);

    printf("\n\nAT THE RECEIVER\nFrames received:\n");
    for(int i=0;i<n;i++){
        c=f[i][0]-'0';
        strncpy(d[i],f[i]+1,c);
        d[i][c]='\0';
        printf("Frame %d: %s\n",i+1,d[i]);
    }

    return 0;
}
